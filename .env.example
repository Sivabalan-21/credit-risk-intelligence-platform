# --- LLM provider for the Talk-to-Data chatbot ---------------------------
# Choose "anthropic" or "openai". Only the corresponding API key is required.
# --- LLM provider ---
LLM_PROVIDER=gemini

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash

DATA_DIR=./data
MODELS_DIR=./models
RAW_TRAIN_FILENAME=application_train.csv
RAW_TEST_FILENAME=application_test.csv
SQLITE_DB_NAME=credit_risk.db

TEST_SIZE=0.2
RANDOM_STATE=42
RISK_LOW_MAX=0.10
RISK_MEDIUM_MAX=0.30

MAX_SQL_ROWS_RETURNED=200
LLM_MAX_TOKENS=800

LOG_LEVEL=INFO